@using System.Reflection
@using PSTT.Dashboard.Models

@if (Model != null)
{
    @foreach (var group in GetGroups())
    {
        @if (!string.IsNullOrEmpty(group.Key))
        {
            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-2 mb-1 px-1" Style="display:block;">@group.Key</MudText>
        }
        <div class="prop-grid">
            @foreach (var entry in group)
            {
                var prop = entry.Prop;
                var attr = entry.Attr;
                var m = Model!;
                <div class="prop-label">
                    <span class="prop-name" title="@attr.DisplayName">@attr.DisplayName</span>
                    @if (!string.IsNullOrEmpty(attr.HelperText))
                    {
                        <MudTooltip Text="@attr.HelperText" Placement="Placement.Right">
                            <MudIcon Icon="@Icons.Material.Filled.Info" Size="Size.Small" Color="Color.Secondary" Style="font-size:13px;vertical-align:middle;" />
                        </MudTooltip>
                    }
                </div>
                <div class="prop-value">
                    @if (attr is NpTextAttribute textAttr)
                    {
                        <MudTextField T="string"
                                      Value="@((string?)prop.GetValue(m))"
                                      ValueChanged="@((string v) => { prop.SetValue(m, v); })"
                                      Lines="@textAttr.Lines"
                                      Placeholder="@(textAttr.Placeholder ?? "")"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense" />
                    }
                    else if (attr is NpCheckboxAttribute)
                    {
                        <MudCheckBox T="bool"
                                     Value="@((bool)(prop.GetValue(m) ?? false))"
                                     ValueChanged="@((bool v) => { prop.SetValue(m, v); })"
                                     Dense="true"
                                     Label="" />
                    }
                    else if (attr is NpSelectAttribute selectAttr)
                    {
                        @RenderSelect(prop, selectAttr, m)
                    }
                    else if (attr is NpNumericAttribute numAttr)
                    {
                        @RenderNumeric(prop, numAttr, m)
                    }
                    else if (attr is NpColorAttribute colorAttr)
                    {
                        <ColorInputRow Value="@((string?)prop.GetValue(m))"
                                       ValueChanged="@((string? v) => { prop.SetValue(m, v); })"
                                       Label=""
                                       ShowClear="@colorAttr.ShowClear" />
                    }
                    else if (attr is NpJsonAttribute jsonAttr)
                    {
                        <JsonEditorField Value="@((string?)prop.GetValue(m))"
                                         ValueChanged="@((string? v) => { prop.SetValue(m, v); })"
                                         Label=""
                                         ExampleJson="@jsonAttr.ExampleJson"
                                         Lines="@jsonAttr.Lines" />
                    }
                    else if (attr is NpCustomAttribute custAttr)
                    {
                        <CustomPropertyCell ComponentType="@custAttr.ComponentType"
                                            Model="@m"
                                            Prop="@prop" />
                    }
                </div>
            }
        </div>
    }
}

@code {
    [Parameter] public object? Model { get; set; }

    private record PropEntry(System.Reflection.PropertyInfo Prop, NodePropertyAttribute Attr);

    private IEnumerable<IGrouping<string, PropEntry>> GetGroups()
    {
        if (Model == null) return [];
        return Model.GetType().GetProperties()
            .Select(p => new PropEntry(p, p.GetCustomAttribute<NodePropertyAttribute>()!))
            .Where(e => e.Attr != null)
            .OrderBy(e => e.Attr.Category ?? "")
            .ThenBy(e => e.Attr.Order)
            .GroupBy(e => e.Attr.Category ?? "");
    }

    private RenderFragment RenderSelect(System.Reflection.PropertyInfo prop, NpSelectAttribute attr, object model) => builder =>
    {
        builder.OpenComponent<MudSelect<string>>(0);
        builder.AddAttribute(1, "Value", (string?)prop.GetValue(model));
        builder.AddAttribute(2, "ValueChanged", EventCallback.Factory.Create<string>(this, v => prop.SetValue(model, v)));
        builder.AddAttribute(3, "Variant", Variant.Outlined);
        builder.AddAttribute(4, "Margin", Margin.Dense);
        builder.AddAttribute(5, "Dense", true);
        builder.AddAttribute(6, "ChildContent", (RenderFragment)(cb =>
        {
            for (int i = 0; i < attr.Options.Length; i++)
            {
                var opt = attr.Options[i];
                var lbl = attr.Labels != null && i < attr.Labels.Length ? attr.Labels[i] : opt;
                cb.OpenComponent<MudSelectItem<string>>(i);
                cb.AddAttribute(0, "Value", opt);
                cb.AddMarkupContent(1, System.Net.WebUtility.HtmlEncode(lbl));
                cb.CloseComponent();
            }
        }));
        builder.CloseComponent();
    };

    private RenderFragment RenderNumeric(System.Reflection.PropertyInfo prop, NpNumericAttribute attr, object model) => builder =>
    {
        bool hasMin = !double.IsNaN(attr.Min);
        bool hasMax = !double.IsNaN(attr.Max);
        int seq = 0;

        if (prop.PropertyType == typeof(int?))
        {
            builder.OpenComponent<MudNumericField<int?>>(seq++);
            builder.AddAttribute(seq++, "Value", (int?)prop.GetValue(model));
            builder.AddAttribute(seq++, "ValueChanged", EventCallback.Factory.Create<int?>(this, v => prop.SetValue(model, v)));
            if (hasMin) builder.AddAttribute(seq++, "Min", (int)attr.Min);
            if (hasMax) builder.AddAttribute(seq++, "Max", (int)attr.Max);
            builder.AddAttribute(seq++, "Variant", Variant.Outlined);
            builder.AddAttribute(seq, "Margin", Margin.Dense);
        }
        else if (prop.PropertyType == typeof(int))
        {
            builder.OpenComponent<MudNumericField<int>>(seq++);
            builder.AddAttribute(seq++, "Value", (int)(prop.GetValue(model) ?? 0));
            builder.AddAttribute(seq++, "ValueChanged", EventCallback.Factory.Create<int>(this, v => prop.SetValue(model, v)));
            if (hasMin) builder.AddAttribute(seq++, "Min", (int)attr.Min);
            if (hasMax) builder.AddAttribute(seq++, "Max", (int)attr.Max);
            builder.AddAttribute(seq++, "Variant", Variant.Outlined);
            builder.AddAttribute(seq, "Margin", Margin.Dense);
        }
        else if (prop.PropertyType == typeof(double?))
        {
            builder.OpenComponent<MudNumericField<double?>>(seq++);
            builder.AddAttribute(seq++, "Value", (double?)prop.GetValue(model));
            builder.AddAttribute(seq++, "ValueChanged", EventCallback.Factory.Create<double?>(this, v => prop.SetValue(model, v)));
            if (hasMin) builder.AddAttribute(seq++, "Min", attr.Min);
            if (hasMax) builder.AddAttribute(seq++, "Max", attr.Max);
            builder.AddAttribute(seq++, "Variant", Variant.Outlined);
            builder.AddAttribute(seq, "Margin", Margin.Dense);
        }
        else
        {
            builder.OpenComponent<MudNumericField<double>>(seq++);
            builder.AddAttribute(seq++, "Value", (double)(prop.GetValue(model) ?? 0.0));
            builder.AddAttribute(seq++, "ValueChanged", EventCallback.Factory.Create<double>(this, v => prop.SetValue(model, v)));
            if (hasMin) builder.AddAttribute(seq++, "Min", attr.Min);
            if (hasMax) builder.AddAttribute(seq++, "Max", attr.Max);
            builder.AddAttribute(seq++, "Variant", Variant.Outlined);
            builder.AddAttribute(seq, "Margin", Margin.Dense);
        }
        builder.CloseComponent();
    };
}

@using PSTT.Dashboard.Services
@using PSTT.Dashboard.Models
@inject ApplicationState AppState

<MudStack Spacing="3">
    <MudTextField Value="@Model!.Name" 
                  ValueChanged="@(async (string v) => { Model.Name = v; await NotifyChanged(); })" 
                  Label="Dashboard Name" Variant="Variant.Outlined" />

    <MudCheckBox T="bool" Value="@Model!.ShowName" 
                 ValueChanged="@(async (bool v) => { Model.ShowName = v; await NotifyChanged(); })" 
                 Label="Show dashboard name in title bar" />

    <ColorInputRow Value="@Model!.BackgroundColor" 
                   ValueChanged="@(async (string? v) => { Model.BackgroundColor = v; await NotifyChanged(); })" 
                   Label="Canvas Background" ShowClear="true" />

    <MudDivider />
    <MudText Typo="Typo.subtitle2">Grid</MudText>
    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
        <MudNumericField Value="@Model!.GridSize" 
                         ValueChanged="@(async (int v) => { Model.GridSize = v; await NotifyChanged(); })" 
                         Label="Grid Size (px)" Variant="Variant.Outlined"
                         Min="5" Max="100" Step="5" Style="max-width:140px;" />
        <MudCheckBox T="bool" Value="@Model!.GridSnapToCenter" 
                     ValueChanged="@(async (bool v) => { Model.GridSnapToCenter = v; await NotifyChanged(); })" 
                     Label="Snap to cell centre" />
    </MudStack>
    <MudText Typo="Typo.caption" Color="Color.Secondary">Grid is always visible in edit mode (5–100 px, step 5). Snap positions nodes at cell intersections when dragging.</MudText>

    <MudDivider />
    <MudText Typo="Typo.subtitle2">Data Topics</MudText>
    <MudList T="string" Dense="true">
        @foreach (var topic in _topics)
        {
            var t = topic;
            <MudListItem T="string" Dense="true" Class="px-0 py-0">
                <div style="display:flex;align-items:center;gap:4px;width:100%;">
                    <MudText Typo="Typo.body2" Style="flex:1;font-family:monospace;">@t</MudText>
                    <MudIconButton Size="Size.Small" Icon="@Icons.Material.Filled.Close"
                                   Color="Color.Error" title="Remove topic"
                                   OnClick="() => RemoveTopic(t)" />
                </div>
            </MudListItem>
        }
        <MudListItem T="string" Dense="true" Class="px-0 py-1">
            <div style="display:flex;align-items:center;gap:4px;width:100%;">
                <MudTextField @bind-Value="_newTopic"
                               Placeholder="e.g. home/sensors/#"
                               Variant="Variant.Text"
                               Margin="Margin.Dense"
                               Style="flex:1;font-family:monospace;"
                               Immediate="true"
                               @onkeydown="HandleTopicKeyDown" />
                <MudIconButton Size="Size.Small" Icon="@Icons.Material.Filled.Add"
                                Color="Color.Primary" title="Add topic"
                                Disabled="@string.IsNullOrWhiteSpace(_newTopic)"
                                OnClick="AddTopic" />
            </div>
        </MudListItem>
    </MudList>
</MudStack>

@if (_isLocalModel)
{
    <div style="display:flex;justify-content:flex-end;gap:8px;margin-top:16px;">
        @if (OnCancelled.HasDelegate)
        {
            <MudButton OnClick="Cancel">Cancel</MudButton>
        }
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="ApplyAsync">Apply</MudButton>
    </div>
}

@code {
    [Parameter] public DashboardModel? Model { get; set; }
    [Parameter] public EventCallback OnChanged { get; set; }
    [Parameter] public EventCallback OnApplied { get; set; }
    [Parameter] public EventCallback OnCancelled { get; set; }

    private bool _isLocalModel;
    private List<string> _topics = new();
    private string _newTopic = "";

    protected override void OnInitialized()
    {
        if (Model == null)
        {
            _isLocalModel = true;
            Model = new DashboardModel
            {
                Name = AppState.DashboardDisplayName,
                ShowName = AppState.ShowName,
                BackgroundColor = AppState.CanvasBackgroundColor,
                GridSize = Math.Max(5, AppState.GridSize),
                GridSnapToCenter = AppState.GridSnapToCenter,
                MqttSubscriptions = new HashSet<string>(AppState.SubscribedTopics)
            };
        }
        SyncTopics();
    }

    protected override void OnParametersSet()
    {
        if (!_isLocalModel)
        {
            SyncTopics();
        }
    }

    private void SyncTopics()
    {
        if (Model != null)
        {
            _topics = (Model.MqttSubscriptions ?? new()).OrderBy(t => t).ToList();
        }
    }

    private async Task NotifyChanged()
    {
        await OnChanged.InvokeAsync();
    }

    private async Task AddTopic()
    {
        var t = _newTopic.Trim();
        if (!string.IsNullOrEmpty(t) && Model != null)
        {
            Model.MqttSubscriptions ??= new();
            if (Model.MqttSubscriptions.Add(t))
            {
                SyncTopics();
                await NotifyChanged();
            }
        }
        _newTopic = "";
    }

    private async Task RemoveTopic(string topic)
    {
        if (Model != null && Model.MqttSubscriptions != null)
        {
            if (Model.MqttSubscriptions.Remove(topic))
            {
                SyncTopics();
                await NotifyChanged();
            }
        }
    }

    private async Task HandleTopicKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await AddTopic();
    }

    private async Task ApplyAsync()
    {
        if (Model != null)
        {
            AppState.SetDisplayName(Model.Name);
            AppState.SetShowDiagramName(Model.ShowName);
            AppState.SetCanvasBackground(Model.BackgroundColor ?? "");
            AppState.SetGridSnapToCenter(Model.GridSnapToCenter);
            AppState.SetGridSize(Model.GridSize);
            AppState.SetSubscribedTopics((Model.MqttSubscriptions ?? new()).ToList());
            AppState.MarkEdited();
            await OnApplied.InvokeAsync();
        }
    }

    private async Task Cancel() => await OnCancelled.InvokeAsync();
}

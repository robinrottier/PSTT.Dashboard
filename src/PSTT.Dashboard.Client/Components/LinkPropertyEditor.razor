@using PSTT.Dashboard.Models
@using PSTT.Dashboard.Services
@using MudBlazor

<MudStack Spacing="2" Class="pa-2">
    <MudText Typo="Typo.subtitle2" Class="mb-1">Link Properties</MudText>

    <MudSelect T="string" Value="Link.Animation"
               ValueChanged="@((string v) => { Link.Animation = v; OnChanged(); })"
               Label="Flow Animation" Variant="Variant.Outlined"
               Margin="Margin.Dense" Dense="true"
               HelperText="Animated overlay driven by Data Topic value">
        <MudSelectItem Value="@("Flow")">Flow (marching ants overlay)</MudSelectItem>
        <MudSelectItem Value="@("None")">None (static line)</MudSelectItem>
    </MudSelect>

    <MudTextField T="string" Value="@Link.DataTopic" Label="Data Topic"
                  Variant="Variant.Outlined" Margin="Margin.Dense"
                  HelperText="Numeric value drives direction (+ = forward, - = reverse)"
                  ValueChanged="OnDataTopicChanged" />

    <MudNumericField T="double" Value="Link.FlowSpeed"
                     ValueChanged="@((double v) => { Link.FlowSpeed = Math.Round(v, 2); OnChanged(); })"
                     Label="Animation Speed (s/cycle)"
                     Variant="Variant.Outlined" Margin="Margin.Dense" Min="0.1" Max="10.0" Step="0.1" />

    <ColorInputRow Value="@Link.Color"
                   ValueChanged="@((string? v) => { Link.Color = v; OnChanged(); })"
                   Label="Line Color" Placeholder="(default)" />

    <ColorInputRow Value="@Link.FlowColor"
                   ValueChanged="@((string? v) => { Link.FlowColor = v; OnChanged(); })"
                   Label="Flow Overlay Color" Placeholder="(line color)" />

    <MudNumericField T="double" Value="Link.Width"
                     ValueChanged="@((double v) => { Link.Width = v; OnChanged(); })"
                     Label="Line Width"
                     Variant="Variant.Outlined" Margin="Margin.Dense" Min="0.5" Max="20.0" Step="0.5" />

    <MudTextField T="string?" Value="@Link.DashPattern" Label="Dash Pattern"
                  Variant="Variant.Outlined" Margin="Margin.Dense" Placeholder="e.g. 5,5 or 10,3,2,3"
                  HelperText="SVG stroke-dasharray for the base line (empty = solid)"
                  ValueChanged="@((string? v) => { Link.DashPattern = v; OnChanged(); })" />
</MudStack>

@code {
    [Parameter] public NodeLinkModel Link { get; set; } = default!;
    [Parameter] public EventCallback OnLinkChanged { get; set; }
    [Parameter] public ApplicationState AppState { get; set; } = default!;

    private void OnChanged()
    {
        Link.Refresh();
        AppState.MarkEdited();
        OnLinkChanged.InvokeAsync();
    }

    private void OnDataTopicChanged(string value)
    {
        Link.DataTopic = value;
        AppState.SetupLinkDataWatcher(Link);
        OnChanged();
    }
}

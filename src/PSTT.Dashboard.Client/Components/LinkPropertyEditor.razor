@using PSTT.Dashboard.Models
@using PSTT.Dashboard.Services
@using MudBlazor
@using Blazor.Diagrams.Core.Models

<MudStack Spacing="2" Class="pa-2">
    <MudText Typo="Typo.subtitle2" Class="mb-1">Link Properties</MudText>

    <MudSelect T="string" Value="Link.Animation"
               ValueChanged="@((string v) => { Link.Animation = v; OnAnimationChanged(); })"
               Label="Flow Animation" Variant="Variant.Outlined"
               Margin="Margin.Dense" Dense="true"
               HelperText="Animated overlay driven by Data Topic value">
        <MudSelectItem Value="@("Flow")">Flow (data driven: + = forward, − = reverse)</MudSelectItem>
        <MudSelectItem Value="@("FlowReverse")">Flow reversed (data driven: − = forward, + = reverse)</MudSelectItem>
        <MudSelectItem Value="@("Forward")">Forward (always)</MudSelectItem>
        <MudSelectItem Value="@("Reverse")">Reverse (always)</MudSelectItem>
        <MudSelectItem Value="@("None")">None (static flow line)</MudSelectItem>
    </MudSelect>

    <MudTextField T="string" Value="@Link.DataTopic" Label="Data Topic"
                  Variant="Variant.Outlined" Margin="Margin.Dense"
                  HelperText="Numeric value drives direction (+ = forward, - = reverse)"
                  ValueChanged="OnDataTopicChanged" />

    @if (Link.Animation is "Flow" or "FlowReverse")
    {
        <MudNumericField T="double?" Value="Link.FlowThreshold"
                         ValueChanged="@((double? v) => { Link.FlowThreshold = v; OnChanged(); })"
                         Label="Flow Threshold (minimum |value| to animate)"
                         Variant="Variant.Outlined" Margin="Margin.Dense" Min="0" Step="0.1"
                         HelperText="Values within ±threshold show a static line instead of animating (0 = only exact zero pauses)" />
    }

    <MudSelect T="FlowShape" Value="Link.FlowShape"
               ValueChanged="@((FlowShape v) => { Link.FlowShape = v; OnChanged(); })"
               Label="Flow Shape" Variant="Variant.Outlined"
               Margin="Margin.Dense" Dense="true">
        <MudSelectItem Value="FlowShape.Dash">Dash (marching ants)</MudSelectItem>
        <MudSelectItem Value="FlowShape.Rectangle">Rectangle (flat caps)</MudSelectItem>
        <MudSelectItem Value="FlowShape.Arrow">Arrow (filled triangle)</MudSelectItem>
        <MudSelectItem Value="FlowShape.Chevron">Chevron (&gt;)</MudSelectItem>
        <MudSelectItem Value="FlowShape.DblChevron">Double Chevron (&gt;&gt;)</MudSelectItem>
        <MudSelectItem Value="FlowShape.TripleChevron">Triple Chevron (&gt;&gt;&gt;)</MudSelectItem>
    </MudSelect>

    <MudNumericField T="double" Value="Link.FlowSpeed"
                     ValueChanged="@((double v) => { Link.FlowSpeed = Math.Round(v, 2); OnChanged(); })"
                     Label="Animation Speed (s/cycle)"
                     Variant="Variant.Outlined" Margin="Margin.Dense" Min="0.1" Max="10.0" Step="0.1" />

    <MudNumericField T="double" Value="Link.FlowSize"
                     ValueChanged="@((double v) => { Link.FlowSize = v; OnChanged(); })"
                     Label="Flow Unit Size (px)"
                     Variant="Variant.Outlined" Margin="Margin.Dense" Min="1" Max="100" Step="1"
                     HelperText="Length of each moving dash or shape" />

    <MudNumericField T="double" Value="Link.FlowGapSize"
                     ValueChanged="@((double v) => { Link.FlowGapSize = v; OnChanged(); })"
                     Label="Flow Gap Size (px)"
                     Variant="Variant.Outlined" Margin="Margin.Dense" Min="1" Max="100" Step="1"
                     HelperText="Gap between each moving unit" />

    <ColorInputRow Value="@Link.Color"
                   ValueChanged="@((string? v) => { Link.Color = v; OnChanged(); })"
                   Label="Line Color" Placeholder="(default)" />

    <ColorInputRow Value="@Link.FlowColor"
                   ValueChanged="@((string? v) => { Link.FlowColor = v; OnChanged(); })"
                   Label="Flow Overlay Color" Placeholder="(line color)" />

    <MudNumericField T="double" Value="Link.Width"
                     ValueChanged="@((double v) => { Link.Width = v; OnChanged(); })"
                     Label="Line Width (px)"
                     Variant="Variant.Outlined" Margin="Margin.Dense" Min="0" Max="20.0" Step="0.5"
                     HelperText="Width of the solid base line. Set to 0 to hide it." />

    <MudNumericField T="double?" Value="Link.FlowWidth"
                     ValueChanged="@((double? v) => { Link.FlowWidth = v; OnChanged(); })"
                     Label="Flow Width (px)"
                     Variant="Variant.Outlined" Margin="Margin.Dense" Min="0" Max="20.0" Step="0.5"
                     Clearable="true"
                     HelperText="Width of the animated overlay. Empty = half of Line Width (0 width = hidden)." />

    <MudSelect T="string" Value="@FlowMarkerName"
               ValueChanged="@((string v) => { Link.FlowMarker = ParseFlowMarker(v); OnChanged(); })"
               Label="Flow Marker" Variant="Variant.Outlined"
               Margin="Margin.Dense" Dense="true"
               HelperText="Arrow marker placed at the downstream end (follows flow direction)">
        <MudSelectItem Value="@("None")">None</MudSelectItem>
        <MudSelectItem Value="@("Arrow")">Arrow ▶</MudSelectItem>
        <MudSelectItem Value="@("Circle")">Circle ●</MudSelectItem>
        <MudSelectItem Value="@("Square")">Square ■</MudSelectItem>
    </MudSelect>

    @if (_sourcePort != null)
    {
        <MudSelect T="string" Value="@_sourcePort.PortStyle"
                   ValueChanged="@((string v) => OnPortStyleChanged(_sourcePort, v))"
                   Label="Source Port Style" Variant="Variant.Outlined"
                   Margin="Margin.Dense" Dense="true">
            <MudSelectItem Value="@("Dot")">Dot (default)</MudSelectItem>
            <MudSelectItem Value="@("Fine")">Fine (small tick)</MudSelectItem>
            <MudSelectItem Value="@("Invisible")">Invisible (hidden)</MudSelectItem>
        </MudSelect>
    }

    @if (_targetPort != null)
    {
        <MudSelect T="string" Value="@_targetPort.PortStyle"
                   ValueChanged="@((string v) => OnPortStyleChanged(_targetPort, v))"
                   Label="Target Port Style" Variant="Variant.Outlined"
                   Margin="Margin.Dense" Dense="true">
            <MudSelectItem Value="@("Dot")">Dot (default)</MudSelectItem>
            <MudSelectItem Value="@("Fine")">Fine (small tick)</MudSelectItem>
            <MudSelectItem Value="@("Invisible")">Invisible (hidden)</MudSelectItem>
        </MudSelect>
    }
</MudStack>

@code {
    [Parameter] public NodeLinkModel Link { get; set; } = default!;
    [Parameter] public EventCallback OnLinkChanged { get; set; }
    [Parameter] public ApplicationState AppState { get; set; } = default!;

    private NodePortModel? _sourcePort => Link.Source?.Model as NodePortModel;
    private NodePortModel? _targetPort => Link.Target?.Model as NodePortModel;

    private string FlowMarkerName => Link.FlowMarker == Blazor.Diagrams.Core.Models.LinkMarker.Arrow  ? "Arrow"
                                   : Link.FlowMarker == Blazor.Diagrams.Core.Models.LinkMarker.Circle ? "Circle"
                                   : Link.FlowMarker == Blazor.Diagrams.Core.Models.LinkMarker.Square ? "Square"
                                   : "None";

    private static Blazor.Diagrams.Core.Models.LinkMarker? ParseFlowMarker(string value) =>
        value switch
        {
            "Arrow"  => Blazor.Diagrams.Core.Models.LinkMarker.Arrow,
            "Circle" => Blazor.Diagrams.Core.Models.LinkMarker.Circle,
            "Square" => Blazor.Diagrams.Core.Models.LinkMarker.Square,
            _        => null,
        };

    private void OnChanged()
    {
        Link.Refresh();
        AppState.MarkEdited();
        OnLinkChanged.InvokeAsync();
    }

    private void OnAnimationChanged()
    {
        AppState.SetupLinkDataWatcher(Link);
        OnChanged();
    }

    private void OnDataTopicChanged(string value)
    {
        Link.DataTopic = value;
        AppState.SetupLinkDataWatcher(Link);
        OnChanged();
    }

    private void OnPortStyleChanged(NodePortModel port, string style)
    {
        port.PortStyle = style;
        port.Refresh();          // sets _shouldRender=true in PortRenderer
        port.Parent.Refresh();   // re-renders node widget → passes updated CSS class to PortRenderer
        AppState.MarkEdited();
        OnLinkChanged.InvokeAsync();
    }
}

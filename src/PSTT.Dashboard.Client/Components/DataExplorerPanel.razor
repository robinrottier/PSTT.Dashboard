@using PSTT.Dashboard.Services
@using PSTT.Dashboard
@implements IDisposable

@if (Embedded)
{
    <div style="display:flex;flex-direction:column;gap:4px;padding:6px;width:100%;height:100%;box-sizing:border-box;">
        @RenderInner
    </div>
}
else
{
    <FloatingPanel Title="Data Explorer" IsOpen="IsOpen" IsOpenChanged="IsOpenChanged"
                   InitialLeft="InitialLeft" InitialTop="InitialTop" MinWidth="340"
                   Resizable="true" InitialWidth="400" InitialHeight="500">
        <div style="display:flex;flex-direction:column;gap:4px;padding:6px;width:100%;height:100%;box-sizing:border-box;min-height:200px;">
            @RenderInner
        </div>
    </FloatingPanel>
}

@code {
    [Parameter] public ApplicationState AppState { get; set; } = default!;
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public EventCallback<bool> IsOpenChanged { get; set; }
    [Parameter] public bool Embedded { get; set; }
    [Parameter] public int InitialLeft { get; set; } = 900;
    [Parameter] public int InitialTop { get; set; } = 160;
    [Parameter] public bool HasSelectedNode { get; set; }
    [Parameter] public IReadOnlyCollection<string>? SelectedNodeTopics { get; set; }
    [Parameter] public EventCallback<string> OnTopicAssigned { get; set; }
    [Parameter] public EventCallback<string> OnCreateNodeWithTopic { get; set; }

    private RenderFragment RenderInner => __builder =>
    {
        __builder.OpenElement(0, "div");
        __builder.AddAttribute(1, "style", "display:flex;align-items:center;gap:4px;");
        // TextField + history menu
        __builder.OpenComponent<MudTextField<string>>(2);
        __builder.AddAttribute(3, "Value", _wildcardInput);
        __builder.AddAttribute(4, "ValueChanged", EventCallback.Factory.Create<string>(this, v => _wildcardInput = v));
        __builder.AddAttribute(5, "Label", "Data topics");
        __builder.AddAttribute(6, "Variant", Variant.Outlined);
        __builder.AddAttribute(7, "Margin", Margin.Dense);
        __builder.AddAttribute(8, "Adornment", Adornment.End);
        __builder.AddAttribute(9, "AdornmentIcon", Icons.Material.Filled.PlayArrow);
        __builder.AddAttribute(10, "OnAdornmentClick", EventCallback.Factory.Create<MouseEventArgs>(this, _ => ApplySubscription()));
        __builder.AddAttribute(11, "Style", "flex:1;");
        __builder.AddAttribute(12, "onkeydown", EventCallback.Factory.Create<KeyboardEventArgs>(this, OnWildcardKeyDown));
        __builder.CloseComponent();
        __builder.OpenComponent<MudMenu>(13);
        __builder.AddAttribute(14, "Icon", Icons.Material.Filled.ArrowDropDown);
        __builder.AddAttribute(15, "Size", Size.Small);
        __builder.AddAttribute(16, "Dense", true);
        __builder.AddAttribute(17, "AnchorOrigin", Origin.BottomRight);
        __builder.AddAttribute(18, "TransformOrigin", Origin.TopRight);
        __builder.AddAttribute(19, "ChildContent", (RenderFragment)(__b2 =>
        {
            if (_history.Count == 0)
            {
                __b2.OpenComponent<MudMenuItem>(0);
                __b2.AddAttribute(1, "Disabled", true);
                __b2.AddAttribute(2, "ChildContent", (RenderFragment)(__b3 => __b3.AddContent(0, "No history")));
                __b2.CloseComponent();
            }
            else
            {
                int seq = 10;
                foreach (var h in _history)
                {
                    var captured = h;
                    __b2.OpenComponent<MudMenuItem>(seq++);
                    __b2.AddAttribute(seq++, "OnClick", EventCallback.Factory.Create(this, () => SelectHistory(captured)));
                    __b2.AddAttribute(seq++, "ChildContent", (RenderFragment)(__b3 => __b3.AddContent(0, captured)));
                    __b2.CloseComponent();
                }
            }
        }));
        __builder.CloseComponent();
        __builder.CloseElement(); // end wildcard row div

        // Topic tree
        __builder.OpenElement(100, "div");
        __builder.AddAttribute(101, "style", "flex:1;overflow-y:auto;scrollbar-gutter:stable;border:1px solid var(--mud-palette-divider);border-radius:4px;");
        if (_topicTree.Count == 0)
        {
            __builder.OpenElement(102, "div");
            __builder.AddAttribute(103, "style", "padding:8px;");
            __builder.OpenComponent<MudText>(104);
            __builder.AddAttribute(105, "Typo", Typo.caption);
            __builder.AddAttribute(106, "Color", Color.Secondary);
            __builder.AddAttribute(107, "ChildContent", (RenderFragment)(__b => __b.AddContent(0, $"No topics match {_activePattern}")));
            __builder.CloseComponent();
            __builder.CloseElement();
        }
        else
        {
            __builder.OpenElement(108, "div");
            __builder.AddAttribute(109, "style", "padding:2px;");
            int seq2 = 200;
            foreach (var node in _topicTree)
            {
                var n = node;
                __builder.OpenComponent<TopicTreeNode>(seq2++);
                __builder.AddAttribute(seq2++, "key", n.FullTopic);
                __builder.AddAttribute(seq2++, "Node", n);
                __builder.AddAttribute(seq2++, "HasSelectedNode", HasSelectedNode);
                __builder.AddAttribute(seq2++, "SelectedNodeTopics", SelectedNodeTopics);
                __builder.AddAttribute(seq2++, "OnTopicAssigned", OnTopicAssigned);
                __builder.AddAttribute(seq2++, "OnCreateNodeWithTopic", OnCreateNodeWithTopic);
                __builder.AddAttribute(seq2++, "ExpandedPaths", _expandedPaths);
                __builder.AddAttribute(seq2++, "OnToggleExpand", EventCallback.Factory.Create<string>(this, ToggleExpand));
                __builder.CloseComponent();
            }
            __builder.CloseElement();
        }
        __builder.CloseElement(); // end tree div

        // Status bar
        __builder.OpenElement(300, "div");
        __builder.AddAttribute(301, "style", "display:flex;justify-content:space-between;align-items:center;");
        __builder.OpenComponent<MudText>(302);
        __builder.AddAttribute(303, "Typo", Typo.caption);
        __builder.AddAttribute(304, "Color", Color.Tertiary);
        __builder.AddAttribute(305, "ChildContent", (RenderFragment)(__b => __b.AddContent(0, $"{_topicCount} topics · {_activePattern}")));
        __builder.CloseComponent();
        __builder.CloseElement();
    };

    private string _wildcardInput = "#";
    private string _activePattern = "#";
    private readonly List<string> _history = ["#", "$DASHBOARD/#"];
    private readonly Dictionary<string, string> _topics = new();
    private List<TopicNode> _topicTree = new();
    private int _topicCount;
    private int _subscriptionGeneration;
    private bool _disposed;
    private readonly List<IDisposable> _subscriptions = new();
    private readonly HashSet<string> _expandedPaths = new();

    protected override void OnInitialized()
    {
        AppState.BridgeScopeChanged += OnBridgeScopeChanged;
        ApplySubscription();
    }

    private void OnBridgeScopeChanged()
    {
        _ = InvokeAsync(ApplySubscription);
    }

    private void ApplySubscription()
    {
        var input = string.IsNullOrWhiteSpace(_wildcardInput) ? "#" : _wildcardInput.Trim();
        _wildcardInput = input;
        _activePattern = input;

        var patterns = ParsePatterns(input);
        AddToHistory(input);

        DisposeSubscriptions();

        int gen = ++_subscriptionGeneration;

        lock (_topics)
        {
            _topics.Clear();
            foreach (var pattern in patterns)
            {
                foreach (var kv in AppState.BridgedDataCache.GetSnapshot(pattern))
                    _topics[kv.Key] = kv.Value;
            }
        }

        _expandedPaths.Clear();

        foreach (var pattern in patterns)
        {
            var sub = AppState.BridgedDataCache.Subscribe(pattern, async sub =>
            {
                if (sub.Status.IsPending) return;
                if (gen != _subscriptionGeneration) return;
                if (_disposed) return;
                lock (_topics) _topics[sub.Key] = sub.Value ?? string.Empty;
                await InvokeAsync(() =>
                {
                    if (gen != _subscriptionGeneration || _disposed) return;
                    RebuildTree();
                    StateHasChanged();
                });
            });
            _subscriptions.Add(sub);
        }

        RebuildTree();
        AutoExpandRoots();
    }

    private static string[] ParsePatterns(string input) =>
        input.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);

    private void DisposeSubscriptions()
    {
        foreach (var sub in _subscriptions) sub.Dispose();
        _subscriptions.Clear();
    }

    private void AddToHistory(string pattern)
    {
        _history.Remove(pattern);
        _history.Insert(0, pattern);
        if (_history.Count > 10)
            _history.RemoveAt(_history.Count - 1);
    }

    private void SelectHistory(string pattern)
    {
        _wildcardInput = pattern;
        ApplySubscription();
    }

    private void OnWildcardKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") ApplySubscription();
    }

    private void RebuildTree()
    {
        List<(string, string)> entries;
        lock (_topics)
            entries = _topics.OrderBy(kv => kv.Key).Select(kv => (kv.Key, kv.Value)).ToList();

        var root = new Dictionary<string, TopicNode>();
        foreach (var (topic, value) in entries)
        {
            var parts = topic.Split('/');
            var current = root;
            TopicNode? node = null;
            for (int i = 0; i < parts.Length; i++)
            {
                var part = parts[i];
                if (!current.TryGetValue(part, out node))
                {
                    node = new TopicNode
                    {
                        Label = part,
                        FullTopic = string.Join("/", parts[..(i + 1)])
                    };
                    current[part] = node;
                }
                if (i == parts.Length - 1)
                    node.Value = value;
                current = node.ChildMap;
            }
        }

        FlattenTree(root);

        _topicTree = root.Values.OrderBy(n => n.Label).ToList();
        _topicCount = entries.Count;
    }

    private static void FlattenTree(Dictionary<string, TopicNode> map)
    {
        foreach (var node in map.Values)
        {
            node.Children = node.ChildMap.Values.OrderBy(n => n.Label).ToList();
            FlattenTree(node.ChildMap);
        }
    }

    private void AutoExpandRoots()
    {
        ExpandBranchNodes(_topicTree);
    }

    private void ExpandBranchNodes(IEnumerable<TopicNode> nodes)
    {
        foreach (var node in nodes)
        {
            if (node.Children.Any(c => !c.IsLeaf))
            {
                _expandedPaths.Add(node.FullTopic);
                ExpandBranchNodes(node.Children);
            }
        }
    }

    private void ToggleExpand(string fullTopic)
    {
        if (!_expandedPaths.Remove(fullTopic))
            _expandedPaths.Add(fullTopic);
        StateHasChanged();
    }

    public void Dispose()
    {
        _disposed = true;
        _subscriptionGeneration++;
        AppState.BridgeScopeChanged -= OnBridgeScopeChanged;
        DisposeSubscriptions();
    }
}


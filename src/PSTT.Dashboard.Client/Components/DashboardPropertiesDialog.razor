@using MudBlazor
@using PSTT.Dashboard.Services
@using PSTT.Dashboard.Components

<MudDialog>
    <DialogContent>
        <DashboardPropertiesContent OnApplied="@(() => MudDialog.Close(DialogResult.Ok(true)))"
                                     OnCancelled="@(() => MudDialog.Cancel())" />
    </DialogContent>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = null!;
}

